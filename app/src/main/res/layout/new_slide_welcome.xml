<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/IntroContent">

    <FrameLayout
        android:id="@+id/welcome_logo_box"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/welcome_logo_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/charonsec_logo_ring" />

        <View
            android:id="@+id/welcome_logo_ring2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/charonsec_logo_ring" />

        <ImageView
            android:id="@+id/welcome_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/charonsec_logo" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/welcome_eyebrow"
        style="@style/IntroEyebrow"
        android:text="@string/intro_eyebrow_welcome" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/welcome_title"
        style="@style/IntroTitle"
        android:text="@string/intro_welcome_title" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/welcome_subtitle"
        style="@style/IntroSubtitle"
        android:text="@string/intro_welcome_body" />
</LinearLayout>
