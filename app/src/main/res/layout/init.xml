<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_ink_0"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingBottom="48dp">

    <ProgressBar
        android:id="@+id/init_spinner"
        style="@style/Ios.Spinner"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/nothing_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/init_title"
        android:textAppearance="@style/TextAppearance.Ios.Subhead"
        android:textColor="@color/ch_bone_dim" />
</LinearLayout>
