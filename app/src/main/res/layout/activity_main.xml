<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_ink_0"
    android:orientation="vertical">

    <!-- Header: where you are, engine state, settings. -->
    <LinearLayout
        android:id="@+id/main_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_crumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/charon_mono"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="01 · HOME"
                android:textAllCaps="true"
                android:textColor="@color/ch_bone_faint"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/stryker_main_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/charon_display"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/ch_bone"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Engine status: id names kept from the old drawer so MainActivity's refresh code still finds them. -->
        <LinearLayout
            android:id="@+id/engine_pill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/ch_pill"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="10dp">

            <View
                android:id="@+id/drawer_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/ch_dot"
                android:backgroundTint="@color/ch_bone_faint" />

            <TextView
                android:id="@+id/drawer_chroot_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/charon_mono"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="ENGINE"
                android:textAllCaps="true"
                android:textColor="@color/ch_bone_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/settings_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:padding="11dp"
            android:src="@drawable/settings"
            app:tint="@color/ch_bone_dim" />

        <!-- Legacy hook: toolbar enable/disable toggles this; kept hidden. -->
        <ImageView
            android:id="@+id/menu_img"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ch_line" />

    <!-- Content runs underneath the frosted nav bar. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/flContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ch_ink_0" />

        <com.zalexdev.stryker.ui.glass.GlassBarLayout
            android:id="@+id/nav_glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <!-- Tools of the selected section. -->
            <HorizontalScrollView
                android:id="@+id/nav_strip_scroll"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/nav_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.zalexdev.stryker.ui.dial.RotaryDialView
                android:id="@+id/nav_dial"
                android:layout_width="match_parent"
                android:layout_height="150dp" />
        </com.zalexdev.stryker.ui.glass.GlassBarLayout>
    </FrameLayout>
</LinearLayout>
