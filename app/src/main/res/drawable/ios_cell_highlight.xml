<?xml version="1.0" encoding="utf-8"?>
<!-- iOS cell highlight: appears instantly on touch, fades out on release. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="0"
    android:exitFadeDuration="@integer/ios_fade_out">
    <item android:state_pressed="true"><color android:color="@color/ch_highlight" /></item>
    <item android:state_focused="true" android:state_window_focused="true"><color android:color="@color/ch_fill" /></item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
