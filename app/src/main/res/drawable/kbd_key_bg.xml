<?xml version="1.0" encoding="utf-8"?>
<!-- iOS keyboard key: rounded cap with a 1dp bottom shadow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">

    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp"><shape><corners android:radius="5dp" /><solid android:color="#40000000" /></shape></item>
            <item android:bottom="1dp"><shape><corners android:radius="5dp" /><solid android:color="@color/ios_key_mod" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp"><shape><corners android:radius="5dp" /><solid android:color="#40000000" /></shape></item>
            <item android:bottom="1dp"><shape><corners android:radius="5dp" /><solid android:color="@color/ios_key" /></shape></item>
        </layer-list>
    </item>
</selector>
