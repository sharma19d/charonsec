<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy style names, now thin aliases of the iOS styles in styles_ios.xml. -->
    <style name="Widget.Stryker.CardView" parent="Ios.Card" />
    <style name="Widget.Stryker.Button" parent="Ios.Button" />

    <style name="Widget.Stryker.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/charon_body</item>
    </style>

    <style name="Widget.Stryker.CustomBottomSheetStyle" parent="Ios.BottomSheet" />
    <style name="ThemeOverlay.Stryker.BottomSheetDialog" parent="ThemeOverlay.Ios.BottomSheetDialog" />
    <style name="Widget.Stryker.FAB" parent="Ios.Fab" />
    <style name="Widget.Charon.ExtendedFab" parent="Ios.ExtendedFab" />

    <style name="Widget.Stryker.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="enforceMaterialTheme">false</item>
        <item name="android:background">@color/ch_ink_1</item>
        <item name="itemIconTint">@color/menu_item</item>
        <item name="itemTextColor">@color/menu_item</item>
        <item name="itemShapeFillColor">@color/menu_item_shape</item>
    </style>

    <style name="Widget.Stryker.AlertDialog" parent="Ios.AlertDialog" />
    <style name="Charon.DialogTitle" parent="Ios.AlertTitle" />
    <style name="Charon.DialogButton" parent="Ios.AlertButton.Preferred" />
    <style name="Charon.DialogButton.Quiet" parent="Ios.AlertButton" />
    <style name="Widget.Stryker.Switch" parent="Ios.MaterialSwitch" />

    <style name="ShapeAppearance.Charon.Control" parent="ShapeAppearance.Ios.Button" />
    <style name="ShapeAppearance.Charon.Panel" parent="ShapeAppearance.Ios.Card" />
    <style name="ShapeAppearance.Charon.Dialog" parent="ShapeAppearance.Ios.Alert" />
    <style name="ShapeAppearance.Stryker.BottomSheet" parent="ShapeAppearance.Ios.Sheet" />

    <style name="ShapeAppearance.News.Image" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="HidKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/kbd_key_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/ch_bone</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="HidKeyWide" parent="HidKey">
        <item name="android:layout_weight">1.6</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HidKeySpace" parent="HidKey">
        <item name="android:layout_weight">5</item>
    </style>

    <style name="HidMod" parent="HidKey">
        <item name="android:background">@drawable/kbd_mod_bg</item>
        <item name="android:layout_weight">1.3</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VmRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="VmRowIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/settings_icon_bg</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="VmRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="VmRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/charon_body</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="VmRowSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/ch_bone_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/charon_body</item>
    </style>

    <style name="VmValueChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/ch_bone_dim</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/charon_body</item>
    </style>

    <style name="VmDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ios_hairline</item>
        <item name="android:layout_marginStart">62dp</item>
        <item name="android:background">@color/ch_line</item>
    </style>

    <style name="DashboardSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/ch_bone_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/charon_body</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="DashboardRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="DashboardRowIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/settings_icon_bg</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="DashboardRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/charon_body</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="DashboardRowCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/ch_bone_dim</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/charon_body</item>
    </style>

    <style name="DashboardRowChevron">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:tint">@color/ch_bone_faint</item>
    </style>

    <style name="DashboardSocial">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/dash_social_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="DashboardSocialIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:tint">@color/ch_signal</item>
    </style>

    <style name="DashboardSocialLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/ch_signal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/charon_body</item>
    </style>
</resources>