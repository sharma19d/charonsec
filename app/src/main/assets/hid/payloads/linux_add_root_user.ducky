REM ============================================================
REM  Linux · Add Root-Level User
REM ============================================================
REM  Creates a new user with UID 0 (root-equivalent) and sets
REM  a known password. Tests whether user creation monitoring
REM  and UID 0 anomaly detection are in place.
REM
REM  Requires sudo. Clean up: sudo userdel -r sysadmin

DEFAULTDELAY 80

DEFINE UNAME sysadmin
DEFINE UPASS Aud1t!Pass

CTRL ALT t
DELAY 1500
STRINGLN sudo useradd -o -u 0 -g 0 -M -d /root -s /bin/bash UNAME
DELAY 1000
STRINGLN echo "UNAME:UPASS" | sudo chpasswd
STRINGLN echo "User UNAME created with UID 0"
STRINGLN exit
